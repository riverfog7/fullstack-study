#!/bin/bash
set -eu
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y docker.io docker-compose-v2
apt-get install -y git curl
systemctl enable --now docker
usermod -aG docker ubuntu

# 공개 저장소에서 첫 배포에 사용할 커밋을 선택합니다.
cd /home/ubuntu
git clone '${repo_url}' fullstack-study
cd fullstack-study
git checkout '${repo_ref}'
cd deploy

# 이미지 선택값만 저장합니다. 토큰·비밀번호·개인키는 넣지 않습니다.
cat > .env <<'ENV'
DOCKERHUB_USERNAME=${dockerhub_username}
IMAGE_TAG=${image_tag}
ENV
chown -R ubuntu:ubuntu ..

# 4주차에 만든 Compose와 배포 명령을 그대로 사용합니다.
bash deploy.sh
